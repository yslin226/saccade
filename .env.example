# Variable names read by Pydantic AI — do not rename.
# Gemini uses GOOGLE_API_KEY, not GEMINI_API_KEY.
GOOGLE_API_KEY=
OPENAI_API_KEY=
SACCADE_CACHE_DIR=./cache

# Azure OpenAI. Needed only for --model azure:<deployment>.
# Gemini's free tier allows 20 requests/minute, which is not enough to
# finish a saccade run over a real sample; Azure is the way around that.
#
# AZURE_OPENAI_DEPLOYMENT is the name *you* chose when creating the
# deployment in the Azure portal — not the model name. One key usually
# covers several deployments, so --model azure:<deployment> overrides this;
# the variable is just the default when no deployment is named.
#
# AZURE_OPENAI_API_VERSION must be a version your resource actually serves.
# "2025-01-01" is not one of them — it returns 404 Resource not found on
# every call, which looks like a missing deployment rather than a bad
# version. 2024-10-21 is the current GA version and works.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
